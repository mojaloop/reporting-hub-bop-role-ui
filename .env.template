# Specify `webpack-dev-server` port.
# You shouldn't need to change this unless there is port collision on
# you local machine.
DEV_PORT=3012

# Where the IAM's public API answers through its gateway, for the dev server
# to proxy `/iam-api` to: a deployment's gateway.
DEV_IAM_URL=

# The IAM's public API as the browser reaches it. On the portal's own host it
# needs a path the shell does not route, since the shell mounts this app at `/iam`.
REACT_APP_API_BASE_URL=/iam-api

# The prefix the deployment gives the IAM; its permission ids are `<prefix>.<operationId>`.
REACT_APP_IAM_SERVICE=iam
